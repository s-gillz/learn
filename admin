function addTyping(){const msgs=document.getElementById('hw-msgs');const t=document.createElement('div');t.className='msg-typing';t.id='typing-ind';t.innerHTML='<span></span><span></span><span></span>';msgs.appendChild(t);msgs.scrollTop=msgs.scrollHeight;}
function removeTyping(){document.getElementById('typing-ind')?.remove();}
function addQR(opts){const msgs=document.getElementById('hw-msgs');const qr=document.createElement('div');qr.className='quick-replies';opts.forEach(opt=>{const b=document.createElement('button');b.className='qr';b.textContent=opt;b.onclick=()=>{qr.remove();processInput(opt);};qr.appendChild(b);});msgs.appendChild(qr);msgs.scrollTop=msgs.scrollHeight;}
async function processInput(text){addMsg('user',text);addTyping();const reply=await getAI(text);removeTyping();const hasWA=reply.includes('[TRANSFER_TO_WA]');addMsg('bot',reply.replace('[TRANSFER_TO_WA]','').trim(),hasWA);}
async function sendMsg(){const inp=document.getElementById('hw-input');const t=inp.value.trim();if(!t)return;inp.value='';await processInput(t);}
