function renderPageEditor(idx,panel){const i=parseInt(idx);const p=S.pages[i];if(!p)return;document.getElementById('panel-title').textContent=`Page: ${p.name}`;panel.innerHTML=card(`/${p.slug} — ${p.name}`,'Page',`<div class="info-box">Exported as <strong>${p.slug}.html</strong> — upload alongside index.html to GitHub.</div><div class="frow">${field('Page Name','pg-name',p.name)}${field('URL Slug','pg-slug',p.slug,'text','e.g. resources → thestudyzone.ca/resources')}</div>${field('Page Headline','pg-headline',p.headline)}${field('Page Description / Intro','pg-desc',p.desc,'textarea')}${field('Main Content (HTML or plain text)','pg-content',p.content,'textarea')}${field('CTA Button Label','pg-cta',p.ctaLabel)}${field('CTA Button Link','pg-ctahref',p.ctaHref)}<div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:4px"><button onclick="savePage(${i})" style="background:var(--forest-deep);color:var(--cream);border:none;border-radius:50px;padding:11px 26px;font-family:Inter,sans-serif;font-size:.85rem;font-weight:600;cursor:pointer">Save Page</button><button onclick="deletePage(${i})" style="background:none;border:1.5px solid var(--red);color:var(--red);border-radius:50px;padding:9px 20px;font-family:Inter,sans-serif;font-size:.85rem;font-weight:600;cursor:pointer">Delete Page</button></div>`);}
function savePage(i){Object.assign(S.pages[i],{name:g('pg-name'),slug:g('pg-slug'),headline:g('pg-headline'),desc:g('pg-desc'),content:g('pg-content'),ctaLabel:g('pg-cta'),ctaHref:g('pg-ctahref')});renderPagesNav();toast(`✓ Page saved`);}
function deletePage(i){if(!confirm(`Delete page "${S.pages[i].name}"?`))return;S.pages.splice(i,1);renderPagesNav();showPanel('seo');toast('Page deleted');}

document.getElementById('page-modal').addEventListener('click',function(e){if(e.target===this)closePageModal();});

