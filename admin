const panelTitles={seo:'SEO & Meta Tags',nav:'Navigation Bar',hero:'Hero Section',trust:'Trust Strip',programs:'Programs',how:'How It Works',reviews:'Reviews & Testimonials',about:'About / Tutor',pricing:'Pricing Plans',contact:'Contact & Hours',footer:'Footer',harsukh:'HarSukh AI Settings'};

function showPanel(id){
  document.querySelectorAll('.sb-item').forEach(el=>el.classList.remove('active'));
  const navEl=document.getElementById('nav-'+id);
  if(navEl)navEl.classList.add('active');
  document.getElementById('panel-title').textContent=panelTitles[id]||id;
  const panel=document.getElementById('panel');
  const renders={seo:renderSEO,nav:renderNav,hero:renderHero,trust:renderTrust,programs:renderPrograms,how:renderHow,reviews:renderReviews,about:renderAbout,pricing:renderPricing,contact:renderContact,footer:renderFooter,harsukh:renderHarSukh};
  if(renders[id])panel.innerHTML=renders[id]();
  else if(id.startsWith('page-'))renderPageEditor(id.replace('page-',''),panel);
  else panel.innerHTML='';
}

function esc(s=''){return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');}
function g(id){const el=document.getElementById(id);return el?el.value:'';}
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2800);}
function card(title,badge,body){return `<div class="ed-card"><div class="ed-card-head"><div class="ed-card-title">${title}</div>${badge?`<span class="ed-card-badge">${badge}</span>`:''}</div><div class="ed-card-body">${body}</div></div>`;}
function field(label,id,value,type='text',hint=''){if(type==='textarea')return `<div class="f"><label>${label}</label><textarea id="${id}">${esc(value)}</textarea>${hint?`<div class="f-hint">${hint}</div>`:''}</div>`;return `<div class="f"><label>${label}</label><input type="${type}" id="${id}" value="${esc(value)}">${hint?`<div class="f-hint">${hint}</div>`:''}</div>`;}
function saveBtn(fn){return `<button onclick="${fn}" style="background:var(--forest-deep);color:var(--cream);border:none;border-radius:50px;padding:11px 26px;font-family:Inter,sans-serif;font-size:.85rem;font-weight:600;cursor:pointer">Save Changes</button>`;}

function renderSEO(){const s=S.seo;return card('Page Title & Description','SEO',`${field('Browser Tab Title','seo-title',s.title,'text','Keep under 60 characters')}${field('Meta Description','seo-desc',s.desc,'textarea','Keep under 155 characters — appears in Google results')}${field('Keywords','seo-kw',s.keywords,'text','Comma-separated local + subject keywords')}`)+card('Social Share Preview','Open Graph',`${field('Social Share Title','seo-og-title',s.ogTitle)}${field('Social Share Description','seo-og-desc',s.ogDesc,'textarea')}<div class="info-box">Shown when someone shares your site on WhatsApp, Facebook, LinkedIn.</div>`)+card('Google Star Rating','Schema',`<div class="frow">${field('Average Rating','seo-rating',s.rating)}${field('Review Count','seo-rc',s.reviewCount)}</div><div class="info-box">Displays star ratings in Google search results under your listing.</div>`)+`<div style="padding:0 0 20px">${saveBtn('saveSEO()')}</div>`;}

function renderNav(){const n=S.nav;return card('Brand & Contact','',`${field('Logo Text','nav-logo',n.logo)}${field('WhatsApp Number (digits + country code)','nav-wa',n.whatsapp,'text','e.g. 19055550199')}`)+card('Navigation Links','',`<div id="nav-links-rep">${n.links.map((l,i)=>`<div class="rep-item"><div class="rep-item-head"><span class="rep-item-lbl">Link ${i+1}</span><button class="rep-del" onclick="delNavLink(${i})">Remove</button></div><div class="frow"><div class="f"><label>Label</label><input type="text" id="nl-lbl-${i}" value="${esc(l.label)}"></div><div class="f"><label>Link</label><input type="text" id="nl-href-${i}" value="${esc(l.href)}"></div></div></div>`).join('')}</div><button class="rep-add" onclick="addNavLink()">+ Add Navigation Link</button>`)+card('CTA Button','',`<div class="frow">${field('Button Label','nav-cta-lbl',n.ctaLabel)}${field('Button Link','nav-cta-href',n.ctaHref)}</div>`)+`<div style="padding:0 0 20px">${saveBtn('saveNav()')}</div>`;}

