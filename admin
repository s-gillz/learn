  const waNum=n.whatsapp||'19055550199';

  const css=`:root{--forest:#1C3A2A;--forest-deep:#0F2119;--forest-mid:#2D5040;--forest-light:#3D6B55;--sage:#7BA08A;--sage-light:#A8C5B5;--cream:#F7F2E8;--cream-warm:#EDE5D0;--cream-deep:#D4C9AC;--gold:#C4953A;--gold-light:#D4A84B;--white:#FDFAF4;--text-on-dark:rgba(247,242,232,0.88);--text-muted-dark:rgba(247,242,232,0.52);--r:12px;--rl:20px;--rxl:32px;}
