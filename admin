function buildSys(){return 'You are ${hs.name}, a warm AI assistant for The Study Zone tutoring in Brampton. Be friendly, concise (under 3 sentences unless needed). Only answer questions about The Study Zone. If stuck, add [TRANSFER_TO_WA] at end. Always encourage the free trial.\\n\\nKNOWLEDGE:\\n'+KB+'\\n\\nFAQS:\\n'+FAQS;}
async function getAI(msg){convHistory.push({role:'user',content:msg});try{const r=await fetch('https://api.anthropic.com/v1/messages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:1000,system:buildSys(),messages:convHistory.slice(-10)})});const d=await r.json();const reply=d.content?.[0]?.text||'';convHistory.push({role:'assistant',content:reply});stuckCount=0;return reply;}catch(e){stuckCount++;return stuckCount>=2?'[TRANSFER_TO_WA]Let me connect you with our team directly.':'Sorry, I had a hiccup! Please rephrase or [TRANSFER_TO_WA]chat with our team.';}}
