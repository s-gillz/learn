<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Site Editor — The Study Zone</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Cormorant+Garamond:wght@600;700&display=swap" rel="stylesheet">
<style>
:root{--forest:#1C3A2A;--forest-deep:#0F2119;--forest-mid:#2D5040;--forest-light:#3D6B55;--sage:#7BA08A;--sage-light:#A8C5B5;--cream:#F7F2E8;--cream-warm:#EDE5D0;--cream-deep:#D4C9AC;--gold:#C4953A;--gold-light:#D4A84B;--white:#FDFAF4;--red:#C0392B;--green:#27AE60;--r:10px;--rl:16px;}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;font-family:'Inter',sans-serif;background:#F0EDE6;color:var(--forest-deep);}
#login-screen{min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--forest-deep);}
.login-box{background:var(--white);border-radius:24px;padding:48px 44px;width:100%;max-width:400px;text-align:center;box-shadow:0 24px 80px rgba(0,0,0,0.3);}
.login-logo{font-family:'Cormorant Garamond',serif;font-size:1.8rem;font-weight:700;color:var(--forest-deep);margin-bottom:6px;}
.login-logo span{color:var(--gold);}
.login-sub{color:var(--sage);font-size:.85rem;margin-bottom:32px;}
.login-label{display:block;text-align:left;font-size:.78rem;font-weight:600;color:var(--forest-mid);margin-bottom:6px;letter-spacing:.4px;}
.login-input{width:100%;padding:13px 16px;border:1.5px solid var(--cream-deep);border-radius:var(--r);font-family:'Inter',sans-serif;font-size:.95rem;color:var(--forest-deep);background:var(--cream);outline:none;transition:border-color .2s;margin-bottom:20px;}
.login-input:focus{border-color:var(--forest-mid);}
.login-btn{width:100%;padding:14px;background:var(--forest-deep);color:var(--cream);border:none;border-radius:50px;font-family:'Inter',sans-serif;font-size:.95rem;font-weight:600;cursor:pointer;transition:background .2s;}
.login-btn:hover{background:var(--forest-mid);}
.login-err{color:var(--red);font-size:.82rem;margin-top:12px;display:none;}
#app{display:none;height:100vh;flex-direction:row;}
#app.visible{display:flex;}
#sidebar{width:240px;background:var(--forest-deep);flex-shrink:0;display:flex;flex-direction:column;border-right:1px solid rgba(196,149,58,0.1);}
.sb-logo{padding:24px 20px 20px;border-bottom:1px solid rgba(255,255,255,0.06);}
.sb-logo-txt{font-family:'Cormorant Garamond',serif;font-size:1.2rem;font-weight:700;color:var(--cream);}
.sb-logo-txt span{color:var(--gold);}
.sb-logo-sub{color:rgba(255,255,255,0.3);font-size:.7rem;margin-top:2px;}
.sb-nav{flex:1;padding:16px 12px;overflow-y:auto;}
.sb-section-lbl{font-size:.65rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:rgba(255,255,255,0.25);padding:12px 8px 6px;}
.sb-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:var(--r);cursor:pointer;color:rgba(255,255,255,0.55);font-size:.84rem;font-weight:400;transition:background .15s,color .15s;margin-bottom:2px;}
.sb-item:hover{background:rgba(255,255,255,0.06);color:rgba(255,255,255,0.85);}
.sb-item.active{background:rgba(196,149,58,0.15);color:var(--gold);font-weight:600;}
.sb-item svg{width:15px;height:15px;fill:currentColor;flex-shrink:0;}
.sb-add-page{margin:8px 12px;padding:10px 12px;background:rgba(196,149,58,0.12);border:1px dashed rgba(196,149,58,0.3);border-radius:var(--r);cursor:pointer;text-align:center;color:var(--gold);font-size:.8rem;font-weight:600;transition:background .2s;}
.sb-add-page:hover{background:rgba(196,149,58,0.2);}
.sb-footer{padding:16px 12px;border-top:1px solid rgba(255,255,255,0.06);}
.sb-logout{color:rgba(255,255,255,0.3);font-size:.78rem;cursor:pointer;transition:color .2s;background:none;border:none;font-family:'Inter',sans-serif;}
.sb-logout:hover{color:rgba(255,255,255,0.7);}
#main{flex:1;display:flex;flex-direction:column;overflow:hidden;}
.top-bar{background:var(--white);border-bottom:1px solid var(--cream-warm);padding:0 28px;height:60px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.top-bar-title{font-size:1rem;font-weight:600;color:var(--forest-deep);}
.top-bar-right{display:flex;gap:10px;align-items:center;}
.tb-btn{padding:8px 18px;border-radius:50px;font-family:'Inter',sans-serif;font-size:.82rem;font-weight:600;cursor:pointer;transition:.2s;border:1.5px solid transparent;}
.tb-preview{background:var(--cream);color:var(--forest-mid);border-color:var(--cream-deep);}
.tb-preview:hover{border-color:var(--sage);}
.tb-export{background:var(--forest-deep);color:var(--cream);border-color:var(--forest-deep);display:flex;align-items:center;gap:6px;}
.tb-export:hover{background:var(--forest-mid);}
.tb-export svg{width:13px;height:13px;fill:var(--cream);}
#panel{flex:1;overflow-y:auto;padding:28px;}
#panel::-webkit-scrollbar{width:5px;}
#panel::-webkit-scrollbar-thumb{background:var(--cream-deep);border-radius:4px;}
.ed-card{background:var(--white);border-radius:var(--rl);border:1px solid var(--cream-warm);margin-bottom:20px;}
.ed-card-head{padding:16px 20px;border-bottom:1px solid var(--cream-warm);display:flex;align-items:center;justify-content:space-between;}
.ed-card-title{font-size:.9rem;font-weight:600;color:var(--forest-deep);}
.ed-card-badge{font-size:.68rem;font-weight:600;padding:2px 8px;border-radius:50px;background:var(--cream);color:var(--sage);border:1px solid var(--cream-deep);}
.ed-card-body{padding:20px;display:flex;flex-direction:column;gap:14px;}
.f{display:flex;flex-direction:column;gap:5px;}
.f label{font-size:.75rem;font-weight:600;color:var(--forest-mid);letter-spacing:.3px;text-transform:uppercase;}
.f input,.f textarea,.f select{padding:10px 13px;border:1.5px solid var(--cream-deep);border-radius:var(--r);font-family:'Inter',sans-serif;font-size:.875rem;color:var(--forest-deep);background:var(--cream);outline:none;transition:border-color .2s,background .2s;}
.f input:focus,.f textarea:focus,.f select:focus{border-color:var(--forest-mid);background:var(--white);}
.f textarea{resize:vertical;min-height:80px;line-height:1.6;}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.frow3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;}
.f-hint{font-size:.72rem;color:var(--sage);margin-top:2px;}
.rep-item{background:var(--cream);border:1px solid var(--cream-deep);border-radius:var(--r);padding:16px;position:relative;margin-bottom:10px;}
.rep-item-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
.rep-item-lbl{font-size:.78rem;font-weight:700;color:var(--forest-mid);}
.rep-del{background:none;border:none;cursor:pointer;color:rgba(192,57,43,0.5);font-size:.75rem;font-weight:600;transition:color .2s;font-family:'Inter',sans-serif;}
.rep-del:hover{color:var(--red);}
.rep-add{border:1.5px dashed var(--cream-deep);background:none;border-radius:var(--r);padding:10px;width:100%;cursor:pointer;color:var(--sage);font-size:.82rem;font-weight:600;font-family:'Inter',sans-serif;transition:border-color .2s,color .2s;}
.rep-add:hover{border-color:var(--sage);color:var(--forest-mid);}
.info-box{background:rgba(196,149,58,0.08);border:1px solid rgba(196,149,58,0.2);border-radius:var(--r);padding:12px 16px;font-size:.8rem;color:var(--forest-mid);line-height:1.55;}
.info-box strong{color:var(--gold);}
#toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--forest-deep);color:var(--cream);padding:12px 24px;border-radius:50px;font-size:.85rem;font-weight:500;box-shadow:0 8px 32px rgba(0,0,0,0.25);z-index:9999;opacity:0;transition:opacity .3s,transform .3s;border:1px solid rgba(196,149,58,0.2);}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
#page-modal{position:fixed;inset:0;background:rgba(15,33,25,0.7);backdrop-filter:blur(6px);z-index:9000;display:none;align-items:center;justify-content:center;padding:20px;}
#page-modal.open{display:flex;}
.pm-box{background:var(--white);border-radius:20px;padding:32px;width:100%;max-width:560px;box-shadow:0 24px 80px rgba(0,0,0,0.25);}
.pm-title{font-size:1.1rem;font-weight:700;color:var(--forest-deep);margin-bottom:20px;}
.pm-actions{display:flex;gap:10px;margin-top:20px;justify-content:flex-end;}
.pm-cancel{background:var(--cream);border:1px solid var(--cream-deep);color:var(--forest-mid);border-radius:50px;padding:9px 20px;font-family:'Inter',sans-serif;font-size:.85rem;font-weight:600;cursor:pointer;}
.pm-save{background:var(--forest-deep);color:var(--cream);border:none;border-radius:50px;padding:9px 24px;font-family:'Inter',sans-serif;font-size:.85rem;font-weight:600;cursor:pointer;transition:background .2s;}
.pm-save:hover{background:var(--forest-mid);}
@media(max-width:768px){#sidebar{width:200px;}.frow,.frow3{grid-template-columns:1fr;}}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="login-screen">
  <div class="login-box">
    <div class="login-logo">The Study <span>Zone</span></div>
    <div class="login-sub">Site Editor · Owner Access Only</div>
    <label class="login-label">Password</label>
    <input class="login-input" type="password" id="login-pw" placeholder="Enter your password">
    <button class="login-btn" onclick="doLogin()">Sign In to Editor</button>
    <div class="login-err" id="login-err">Incorrect password. Try again.</div>
    <p style="margin-top:20px;font-size:.72rem;color:#aaa">This page is for site owners only.<br>Not linked from your public website.</p>
  </div>
</div>

<!-- APP SHELL -->
<div id="app">
  <div id="sidebar">
    <div class="sb-logo">
      <div class="sb-logo-txt">The Study <span>Zone</span></div>
      <div class="sb-logo-sub">Site Editor</div>
    </div>
    <div class="sb-nav">
      <div class="sb-section-lbl">Main Website</div>
      <div class="sb-item active" onclick="showPanel('seo')" id="nav-seo"><svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>SEO &amp; Meta</div>
      <div class="sb-item" onclick="showPanel('nav')" id="nav-nav"><svg viewBox="0 0 24 24"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>Navigation</div>
      <div class="sb-item" onclick="showPanel('hero')" id="nav-hero"><svg viewBox="0 0 24 24"><path d="M21 3H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H3V5h18v14zm-10-7h9v5h-9z"/></svg>Hero Section</div>
      <div class="sb-item" onclick="showPanel('trust')" id="nav-trust"><svg viewBox="0 0 24 24"><path d="M12 2L3 7v5c0 5.25 3.75 10.15 9 11.35C17.25 22.15 21 17.25 21 12V7L12 2z"/></svg>Trust Strip</div>
      <div class="sb-item" onclick="showPanel('programs')" id="nav-programs"><svg viewBox="0 0 24 24"><path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/></svg>Programs</div>
      <div class="sb-item" onclick="showPanel('how')" id="nav-how"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>How It Works</div>
      <div class="sb-item" onclick="showPanel('reviews')" id="nav-reviews"><svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>Reviews</div>
      <div class="sb-item" onclick="showPanel('about')" id="nav-about"><svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>About / Tutor</div>
      <div class="sb-item" onclick="showPanel('pricing')" id="nav-pricing"><svg viewBox="0 0 24 24"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>Pricing</div>
      <div class="sb-item" onclick="showPanel('contact')" id="nav-contact"><svg viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>Contact &amp; Hours</div>
      <div class="sb-item" onclick="showPanel('footer')" id="nav-footer"><svg viewBox="0 0 24 24"><path d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.11 0 2-.89 2-2V5c0-1.11-.89-2-2-2zm0 5h-2V5h2v3zM4 19h16v2H4z"/></svg>Footer</div>
      <div class="sb-item" onclick="showPanel('harsukh')" id="nav-harsukh"><svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/></svg>HarSukh AI</div>
      <div class="sb-section-lbl" style="margin-top:8px">Extra Pages</div>
      <div id="pages-nav"></div>
      <div class="sb-add-page" onclick="openPageModal()">+ Add New Page</div>
    </div>
    <div class="sb-footer"><button class="sb-logout" onclick="doLogout()">← Sign out</button></div>
  </div>

  <div id="main">
    <div class="top-bar">
      <div class="top-bar-title" id="panel-title">SEO &amp; Meta Tags</div>
      <div class="top-bar-right">
        <button class="tb-btn tb-preview" onclick="toast('Open index.html in Chrome to preview')">👁 Preview</button>
        <button class="tb-btn tb-export" onclick="exportSite()">
          <svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
          Download index.html
        </button>
      </div>
    </div>
    <div id="panel"></div>
  </div>
</div>

<!-- PAGE MODAL -->
<div id="page-modal">
  <div class="pm-box">
    <div class="pm-title">Add New Page</div>
    <div style="display:flex;flex-direction:column;gap:14px">
      <div class="f"><label>Page Name</label><input id="pm-name" type="text" placeholder="e.g. Resources, Blog, Online Tutoring"></div>
      <div class="f"><label>URL Slug</label><input id="pm-slug" type="text" placeholder="e.g. resources (becomes thestudyzone.ca/resources)"></div>
      <div class="f"><label>Page Headline</label><input id="pm-headline" type="text" placeholder="e.g. Free Resources for Ontario Students"></div>
      <div class="f"><label>Page Description</label><textarea id="pm-desc" style="min-height:60px" placeholder="Brief intro shown at top of page..."></textarea></div>
    </div>
    <div class="pm-actions">
      <button class="pm-cancel" onclick="closePageModal()">Cancel</button>
      <button class="pm-save" onclick="addPage()">Create Page</button>
    </div>
  </div>
</div>

<div id="toast"></div>
<script>
const PASS='studyzone2026';
function doLogin(){const pw=document.getElementById('login-pw').value;if(pw===PASS){document.getElementById('login-screen').style.display='none';document.getElementById('app').classList.add('visible');showPanel('seo');renderPagesNav();}else{document.getElementById('login-err').style.display='block';document.getElementById('login-pw').value='';}}
document.getElementById('login-pw').addEventListener('keydown',e=>{if(e.key==='Enter')doLogin();});
function doLogout(){document.getElementById('app').classList.remove('visible');document.getElementById('login-screen').style.display='flex';document.getElementById('login-pw').value='';}

const S={
  seo:{title:'The Study Zone | Expert Tutoring in Brampton, Ontario',desc:'Top-rated math, science and reading tutoring in Brampton by certified Ontario teachers. Free first session. Book today.',keywords:'tutoring Brampton, math tutor Brampton, Grade 9 science tutor, EQAO prep Brampton, The Study Zone',ogTitle:'The Study Zone | Expert Tutoring in Brampton',ogDesc:'Certified Ontario teachers. Math, Science & Reading. Book your free trial session today.',rating:'4.9',reviewCount:'87'},
