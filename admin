  hero:{badge:"Brampton's Trusted Educators Since 2018",h1:'Where Students Find Their Academic Edge',h1em:'Academic Edge',sub:'Expert tutoring in Math, Science & Reading by a certified Ontario teacher — designed around your child, not a template.',btn1:'Book a Free Trial Session',btn1href:'#contact',btn2:'Explore Programs',btn2href:'#programs',stat1num:'200+',stat1lbl:'Students Helped',stat2num:'4.9★',stat2lbl:'Google Rating',stat3num:'8 yrs',stat3lbl:'Teaching Experience'},
  trust:[{text:'Ontario Certified Teacher'},{text:'Free Assessment Session'},{text:'Ontario 2022 Curriculum'},{text:'4.9 / 5 — 87 Google Reviews'},{text:'1-on-1 & Small Group'}],
  programs:[
    {tag:'Grades 1–8',name:'Elementary Math',desc:'Number sense, fractions, decimals, geometry, EQAO prep.',img:'https://images.pexels.com/photos/3771074/pexels-photo-3771074.jpeg?auto=compress&cs=tinysrgb&w=700'},
    {tag:'Grades 9–10',name:'High School Math',desc:'MPM1D & MPM2D — algebra, linear systems, geometry.',img:'https://images.pexels.com/photos/5212700/pexels-photo-5212700.jpeg?auto=compress&cs=tinysrgb&w=700'},
    {tag:'Grade 9',name:'Science (SNC1W)',desc:'Biology, Chemistry & Physics. Full Ontario de-streamed curriculum.',img:'https://images.pexels.com/photos/8613089/pexels-photo-8613089.jpeg?auto=compress&cs=tinysrgb&w=700'},
    {tag:'Grades 3–8',name:'Reading & Comprehension',desc:'Fluency, critical thinking & OSSLT prep.',img:'https://images.pexels.com/photos/5905555/pexels-photo-5905555.jpeg?auto=compress&cs=tinysrgb&w=700'},
    {tag:'Grades 3, 6 & 9',name:'EQAO Prep',desc:'Past papers, strategies, walkthroughs.',img:'https://images.pexels.com/photos/4145153/pexels-photo-4145153.jpeg?auto=compress&cs=tinysrgb&w=700'},
    {tag:'All Grades',name:'Online Tutoring',desc:'Same teacher, same quality — live sessions with digital workspace.',img:'https://images.pexels.com/photos/4491461/pexels-photo-4491461.jpeg?auto=compress&cs=tinysrgb&w=700'}
  ],
  how:{sectionLabel:'The Process',h2:'Simple. Structured. Effective.',sub:'Three steps from first call to real results in the classroom.',badgeNum:'Free',badgeTxt:'First session, always',photo:'https://images.pexels.com/photos/5212361/pexels-photo-5212361.jpeg?auto=compress&cs=tinysrgb&w=700',steps:[{num:'01',title:'Book Your Free Assessment',desc:'A no-pressure 30-minute session where we identify gaps, strengths, and fastest path forward.'},{num:'02',title:'Receive a Personalized Learning Plan',desc:'A custom roadmap tied to Ontario curriculum expectations — no generic worksheets.'},{num:'03',title:'Watch the Progress Happen',desc:'Regular sessions, progress reports, and open parent communication.'}]},
